# Template for .env.local — copy this file, fill in real values, never commit the copy.
# See README.md "Setup" for what each value does and how to obtain it, and
# docs/ci-cd-and-environments.md for how these map onto Vercel Preview/Production.

# --- Google Maps Platform (Maps JavaScript, Geocoding, Places, Routes APIs) ---
GOOGLE_MAPS_API_KEY=

# --- Stadia Maps basemap (ADR-0027) — optional locally, no key needed on localhost ---
NEXT_PUBLIC_STADIA_API_KEY=

# --- VROOM + OSRM (ADR-0023/0024) — local Docker defaults shown; hosted URLs on Vercel ---
VROOM_URL=http://localhost:8080
OSRM_FOOT_URL=http://localhost:5002
OSRM_CAR_URL=http://localhost:5010

# --- Database (ADR-0037) — unset locally to fall back to db/dev.db; required on Vercel ---
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# --- Access gate (ADR-0037) — required on Vercel (Preview/Production); skipped automatically on
# localhost, so it's optional here unless you want to exercise /login during local dev ---
SITE_PASSWORD=
