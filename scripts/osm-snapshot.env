# Shared pin for both OSM ingest pipelines (rail: ingest-transit-graph.sh, road:
# build-osrm-graphs.sh). ADR-0024's 2026-08-07 amendment: the invariant the two pipelines must
# share is the snapshot DATE, not a URL — rail needs the whole of Japan (it filters down to a
# ~9 MB graph regardless), road needs a sub-region sized to the build machine, so there is no
# single file both scripts can point at. Bump OSM_SNAPSHOT deliberately when refreshing either
# graph; never point either region at a rolling "-latest" URL from automation.

GEOFABRIK_BASE="https://download.geofabrik.de"
OSM_SNAPSHOT="260101"
OSM_RAIL_REGION="asia/japan"
OSM_ROAD_REGION="asia/japan/kanto"
